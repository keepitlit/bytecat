{
  "_comment": [
    "Fixed retrieval evaluation set for tests/fixtures/eval-corpus (a small,",
    "entirely fictional set of notes). Queries were written by reading the",
    "corpus, never by reading rankings, so the set is not fitted to whatever",
    "the ranker happens to do today. Controls that already pass are included",
    "on purpose: an average that only contains hard cases hides regressions",
    "in the easy ones.",
    "",
    "'expect' is every file a reasonable person would accept as a correct",
    "answer. 'noise_globs' lists paths that are never a useful answer to",
    "anything here; the attractor metric counts how many top-5 slots they",
    "steal.",
    "",
    "To run it against the fixture corpus:",
    "  export BYTECAT_HOME=$(mktemp -d)",
    "  python3 -m bytecat scan tests/fixtures/eval-corpus | python3 -m bytecat merge",
    "  python3 -m bytecat pipeline      # embed step needs a local model; keyword-only otherwise",
    "  python3 -m bytecat eval"
  ],
  "noise_globs": [
    ".graphify/cache/*",
    ".graphify/manifest.json",
    "scratch/*"
  ],
  "queries": [
    {"q": "taxes",
     "expect": ["TAX-SEASON.md", "taxes/2024-personal-return-summary.md"], "tier": "direct"},
    {"q": "coffee brewing",
     "expect": ["coffee/coffee-brewing-notes.md"], "tier": "direct"},
    {"q": "obsidian keyboard shortcuts",
     "expect": ["Notes App Hotkeys.md"], "tier": "direct"},
    {"q": "security audit",
     "expect": ["home/security-audit-2026-03.md"], "tier": "direct"},
    {"q": "trademark filing brief",
     "expect": ["business/trademark-filing-brief.md"], "tier": "direct"},
    {"q": "sourdough recipe",
     "expect": ["recipes/sourdough.md"], "tier": "direct"},
    {"q": "oil change",
     "expect": ["car/oil-change-log.md"], "tier": "direct"},
    {"q": "dentist appointment",
     "expect": ["health/dentist-appointment-2026-04.txt"], "tier": "direct"},
    {"q": "invoice for the bakery",
     "expect": ["business/invoice-2026-02-0007.txt"], "tier": "direct"},
    {"q": "when to plant tomatoes",
     "expect": ["garden/planting-calendar.md", "garden/tomato-varieties.md"], "tier": "abstract"},
    {"q": "a letter someone wrote me",
     "expect": ["letters/complaint-about-the-website.txt"], "tier": "abstract"},
    {"q": "someone complaining about the website",
     "expect": ["letters/complaint-about-the-website.txt"], "tier": "abstract"},
    {"q": "what to bring camping",
     "expect": ["travel/packing-list-camping.md", "travel/cabin-trip-2025-08.md"], "tier": "abstract"},
    {"q": "how to keep a secret token safe",
     "expect": ["token-hygiene.md"], "tier": "abstract"},
    {"q": "the leak under the sink",
     "expect": ["letters/landlord-reply-2026-01.md"], "tier": "abstract"},
    {"q": "donation receipt",
     "expect": ["taxes/receipts-2024/charity-food-bank.txt"], "tier": "abstract"},
    {"q": "books I want to read",
     "expect": ["reading/to-read.md"], "tier": "abstract"},
    {"q": "how much will the deck cost",
     "expect": ["projects/deck-rebuild-plan.md"], "tier": "abstract"},
    {"q": "sensor project on a raspberry pi",
     "expect": ["projects/raspberry-pi-weather-station.md"], "tier": "abstract"},
    {"q": "focus and avoiding distraction",
     "expect": ["reading/book-notes-deep-work.md"], "tier": "abstract"}
  ]
}
